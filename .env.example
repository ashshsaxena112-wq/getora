# ==============================================================================
# GETORA ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Credentials (from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend Environment (Optional for Express service)
PORT=5000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Ola Maps / Krutrim Maps API Key (https://maps.olacabs.com)
VITE_OLA_MAPS_API_KEY=your_ola_maps_api_key_here
OLA_MAPS_API_KEY=your_ola_maps_api_key_here
